# BFF API URL used by the frontend build
BFF_APP_API_URL=http://localhost:8081

# Public site URL
VITE_SITE_URL=http://localhost:5173

# Supabase public client configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Impressum / legal contact information
VITE_IMPRESSUM_NAME=
VITE_IMPRESSUM_ADDRESS=
VITE_IMPRESSUM_CITY=
VITE_IMPRESSUM_PHONE=
VITE_IMPRESSUM_EMAIL=

# Google Cloud Storage bucket containing public drill images
VITE_PUBLIC_BUCKET_NAME=your-public-images-bucket
