{
  "name": "swim-gen-bff",
  "version": "1.0.0",
  "description": "A web application for generating, recommeding and sharing training plans for swimmers, triathletes and trainers.",
  "main": "index.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "dev": "dotenv -e .env.development -- nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/main.ts",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5pirit5eal/swim-gen.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "^26.12.1"
  },
  "bugs": {
    "url": "https://github.com/5pirit5eal/swim-gen/issues"
  },
  "homepage": "https://github.com/5pirit5eal/swim-gen#readme",
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.1.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-define-config": "^2.1.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
