# Google Cloud configuration
PROJECT_ID=your-gcp-project-id
REGION=eu

# Generative AI models
MODEL=gemini-3.7-flash
SMALL_MODEL=gemini-3.5-flash-lite

# Embedding stores
EMBEDDING_NAME=embeddings
EMBEDDING_DRILL_NAME=drill_embeddings
# Must implement the Gemini Embedding 2 interface documented in backend/README.md.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_SIZE=768

# PostgreSQL / Supabase connection
DB_NAME=postgres
DB_HOST=your-database-host
DB_PORT=5432
DB_USER=your-database-user
DB_PASS=your-database-password
# Use this instead of DB_PASS when loading the password from Google Secret Manager.
DB_PASS_LOCATION=
DB_SSLMODE=require

# Logging and HTTP server
LOG_LEVEL=INFO
PORT=8080
SWAGGER_ENABLED=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Cloud Storage for PDF exports
BUCKET_NAME=your-pdf-export-bucket
SIGNING_SA=your-pdf-export-service-account@your-gcp-project-id.iam.gserviceaccount.com

# Chat configuration
CHAT_HISTORY_LIMIT=10
CHAT_USE_RAG_CONTEXT=true

# Optional OpenTelemetry configuration
OTEL_SERVICE_NAME=swim-gen-backend
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Optional: set when using local Google Cloud Application Default Credentials.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
